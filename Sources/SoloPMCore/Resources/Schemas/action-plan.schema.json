{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solopm.dev/schemas/action-plan.schema.json",
  "title": "SoloPM ActionPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "userInput", "summary", "actions", "riskLevel", "requiresApproval"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "userInput": { "type": "string" },
    "summary": { "type": "string", "minLength": 1 },
    "riskLevel": { "$ref": "#/$defs/riskLevel" },
    "requiresApproval": { "type": "boolean" },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "$defs": {
    "riskLevel": {
      "type": "string",
      "enum": ["read", "draft", "write", "danger"]
    },
    "tool": {
      "type": "string",
      "enum": [
        "project.create",
        "project.update",
        "project.list",
        "project.get",
        "project.complete",
        "project.delete",
        "task.create",
        "task.bulk_create",
        "task.list",
        "task.get",
        "task.update",
        "task.complete",
        "task.delete",
        "task.list_due",
        "task.list_overdue",
        "notification.schedule",
        "notification.schedule_relative",
        "notification.schedule_overdue_rule",
        "notification.cancel",
        "notification.list",
        "calendar.create_event",
        "calendar.create_deadline",
        "calendar.create_work_block",
        "reminders.create",
        "reminders.bulk_create",
        "reminders.mark_complete",
        "filesystem.create_directory",
        "filesystem.create_markdown_file",
        "filesystem.create_artifacts_from_frame",
        "filesystem.scan_project_artifacts",
        "frame.search",
        "frame.list",
        "frame.get",
        "frame.create",
        "frame.update",
        "frame.delete",
        "maildraft.create_text",
        "git.status",
        "git.branch",
        "git.log_summary",
        "git.diff_summary",
        "development.pr_workflow.prepare",
        "development.repository.read_file",
        "development.repository.create_file",
        "development.repository.update_file",
        "development.verification.run"
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tool"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tool": { "$ref": "#/$defs/tool" },
        "riskLevel": { "$ref": "#/$defs/riskLevel" },
        "requiresUserConfirmation": { "type": "boolean" },
        "arguments": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
