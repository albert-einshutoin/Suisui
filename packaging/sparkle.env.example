# Copy this file to packaging/sparkle.env for a local release machine,
# or export the same variables in a CI job. Keep the Sparkle private update
# key in Keychain via Sparkle's generate_keys tool.

SUISUI_SPARKLE_FEED_URL=
SUISUI_SPARKLE_PUBLIC_ED_KEY=
SUISUI_SPARKLE_BIN_DIR=
SUISUI_SPARKLE_SIGN_UPDATE=
SUISUI_SPARKLE_DOWNLOAD_URL_PREFIX=
SUISUI_REQUIRE_SPARKLE_TOOLS=1
