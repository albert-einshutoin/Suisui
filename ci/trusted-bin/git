#!/usr/bin/env bash
set -euo pipefail

work_tree=""
expected_global_value=""
git_subcommand=""
for argument in "$@"; do
  if [[ "$expected_global_value" == "-C" ]]; then
    if [[ "$argument" == /* ]]; then
      work_tree="$argument"
    else
      work_tree="${work_tree:-$PWD}/$argument"
    fi
    work_tree="$(cd "$work_tree" && pwd -P)"
    expected_global_value=""
    continue
  fi
  if [[ -n "$expected_global_value" ]]; then
    expected_global_value=""
    continue
  fi
  case "$argument" in
    -C) expected_global_value="-C" ;;
    -c|--config-env) expected_global_value="option" ;;
    --git-dir|--git-dir=*|--work-tree|--work-tree=*)
      printf 'trusted git rejects caller-controlled repository roots\n' >&2
      exit 2
      ;;
    -*) ;;
    *) git_subcommand="$argument"; break ;;
  esac
done

trusted_config=(
  -c core.fsmonitor=false
  -c core.ignoreStat=false
  -c core.trustctime=true
  -c core.checkStat=default
  -c core.fileMode=true
  -c core.abbrev=8
  -c core.hooksPath=/dev/null
)
git_arguments=("${trusted_config[@]}" "$@")

trusted_environment=(
  /usr/bin/env -i
  PATH=/usr/bin:/bin
  HOME=/dev/null
  XDG_CONFIG_HOME=/dev/null
  GIT_CONFIG_NOSYSTEM=1
  GIT_NO_REPLACE_OBJECTS=1
)

filter_probe_arguments=(-C "${work_tree:-$(/bin/pwd -P)}")
case "$git_subcommand" in
  status|diff|add|commit|checkout|restore)
    local_bare="$(
      "${trusted_environment[@]}" /usr/bin/git \
        "${filter_probe_arguments[@]}" \
        "${trusted_config[@]}" \
        config --local --includes --bool --get core.bare \
        2>/dev/null || true
    )"
    if [[ "$local_bare" == "true" ]] || "${trusted_environment[@]}" /usr/bin/git \
      "${filter_probe_arguments[@]}" \
      "${trusted_config[@]}" \
      config --local --includes --get core.worktree \
      >/dev/null 2>&1; then
      printf 'trusted git rejects repository-local work tree overrides\n' >&2
      exit 2
    fi
    ;;
esac
if "${trusted_environment[@]}" /usr/bin/git \
  "${filter_probe_arguments[@]}" \
  "${trusted_config[@]}" \
  config --includes --get-regexp '^filter\..*\.(clean|process)$' \
  >/dev/null 2>&1; then
  printf 'trusted git rejects repository-local content filters\n' >&2
  exit 2
fi

exec "${trusted_environment[@]}" /usr/bin/git "${git_arguments[@]}"
