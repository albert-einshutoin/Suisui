#!/usr/bin/env bash
set -euo pipefail

work_tree="$PWD"
previous_argument=""
for argument in "$@"; do
  if [[ "$previous_argument" == "-C" ]]; then
    if [[ "$argument" == /* ]]; then
      work_tree="$argument"
    else
      work_tree="$work_tree/$argument"
    fi
    work_tree="$(cd "$work_tree" && pwd -P)"
    previous_argument=""
  elif [[ "$argument" == "-C" ]]; then
    previous_argument="-C"
  fi
done

exec /usr/bin/env -i \
  PATH=/usr/bin:/bin \
  GIT_NO_REPLACE_OBJECTS=1 \
  /usr/bin/git \
  --work-tree="$work_tree" \
  -c core.bare=false \
  -c core.fsmonitor=false \
  -c core.ignoreStat=false \
  -c core.trustctime=true \
  -c core.checkStat=default \
  -c core.fileMode=true \
  -c core.abbrev=8 \
  -c core.hooksPath=/dev/null \
  "$@"
